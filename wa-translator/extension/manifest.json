{
  "manifest_version": 3,
  "name": "WA Translator & Reply Assistant",
  "short_name": "WA Translator",
  "version": "1.0.0",
  "description": "Terjemahan otomatis pesan WhatsApp Web dan saran balasan (Positif / Tahan / Tolak) untuk tim CS & bisnis.",
  "minimum_chrome_version": "116",
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "WA Translator — buka/tutup panel",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_page": "options.html",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["lib/langs.js", "content/wa-dom.js", "content/app.js"],
      "css": ["content/inline.css"],
      "run_at": "document_idle"
    }
  ]
}
